+		if (!ordinal) return "";
+		const id = ordinal.identifier;
+		switch (ordinal.type) {
+			case "part": return `第 ${id} 部　`;
+			case "chapter": return `第 ${id} 章　`;
+			case "episode": return `第 ${id} 集　`;
+			case "appendix": return id == null ? "附錄　" : `附錄 ${id}　`;
+			case "section": return `第 ${id} 節　`;
+			case "level": return `第 ${id} 層　`;
+			default: return Parser.bookOrdinalToAbv(ordinal);
+		}
+	}
+
