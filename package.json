{
  "name": "5ewt-zh-tw-overlay",
	"version": "2.33.3-zh-tw.9",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/bootstrap-upstream.mjs",
    "apply": "node scripts/apply-overlay.mjs",
    "verify": "node scripts/verify-overlay.mjs",
    "setup": "npm run bootstrap && npm run apply && npm run verify",
    "extract:classes": "node scripts/run-extract-classes.mjs",
    "import:classes": "python vendor/5etools-src/node/zh-tw/import-full-class-translations.py",
    "build:class-locale": "node vendor/5etools-src/node/zh-tw/build-class-locale.mjs",
    "import:rules": "python vendor/5etools-src/node/zh-tw/import-core-rules.py",
    "build:site-locale": "node vendor/5etools-src/node/zh-tw/build-site-locale.mjs",
    "test:classes": "node vendor/5etools-src/node/zh-tw/test-class-i18n.mjs && node vendor/5etools-src/node/zh-tw/test-class-body-i18n.mjs && node vendor/5etools-src/node/zh-tw/test-class-body-i18n-full.mjs",
    "validate:classes": "node vendor/5etools-src/node/zh-tw/validate-full-class-translations.mjs",
    "test:site": "node vendor/5etools-src/node/zh-tw/test-site-i18n.mjs",
		"test:rules": "node vendor/5etools-src/node/zh-tw/test-rules-i18n.mjs && node vendor/5etools-src/node/zh-tw/test-quick-reference-i18n.mjs",
		"validate:rules": "node vendor/5etools-src/node/zh-tw/validate-core-rules.mjs",
		"test:spells": "node vendor/5etools-src/node/zh-tw/test-content-i18n.mjs",
		"validate:spells": "node vendor/5etools-src/node/zh-tw/validate-content-translations.mjs",
		"test:character-options": "node vendor/5etools-src/node/zh-tw/test-content-i18n.mjs",
		"validate:character-options": "node vendor/5etools-src/node/zh-tw/validate-character-options-translations.mjs",
		"import:items": "python vendor/5etools-src/node/zh-tw/import-content-translations.py items",
		"test:items": "node vendor/5etools-src/node/zh-tw/test-item-i18n.mjs && node vendor/5etools-src/node/zh-tw/test-item-page-runtime.mjs",
		"validate:items": "node vendor/5etools-src/node/zh-tw/validate-item-translations.mjs",
		"import:monsters": "python vendor/5etools-src/node/zh-tw/import-content-translations.py monsters",
		"test:monsters": "node vendor/5etools-src/node/zh-tw/test-monster-i18n.mjs && node vendor/5etools-src/node/zh-tw/test-monster-page-runtime.mjs",
		"validate:monsters": "node vendor/5etools-src/node/zh-tw/validate-monster-translations.mjs",
		"test:small-fragments": "node vendor/5etools-src/node/zh-tw/test-small-fragments-and-bastions.mjs",
		"serve": "npm --prefix vendor/5etools-src run serve:dev"
  }
}
