	"monsterFluff": [
		{
			"name": "煙霧龍獸",
			"source": "DoSI",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"煙霧龍獸是從死去巨龍的綿長魔法能量中誕生的調皮生物，他們外形像由綠色煙霧構成的無腿小龍。以使其他生物感到痛苦和困惑為樂。"
					]
				}
			],
			"ENG_name": "Fume Drake"
		},
		{
			"name": "狗頭人修補匠",
			"source": "DoSI",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"狗頭人是一種卵生類人生物，通常為巨龍服務。身體孱弱的它們不得不團結一致以保持力量。",
						"少數狗頭人天生有皮翼且可以飛行，被視為是龍神的贈禮。"
					]
				}
			],
			"ENG_name": "Kobold Tinkerer"
		},
		{
			"name": "邁羅人魚敲詐者",
			"source": "DoSI",
			"images": [
				{
