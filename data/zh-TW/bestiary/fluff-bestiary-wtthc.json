						"path": "bestiary/WttHC/Gnoll Warrior (Stranger Things).webp"
					},
					"width": 1000,
					"height": 961
				}
			],
			"ENG_name": "Gnoll Warrior"
		},
		{
			"name": "地精武者",
			"source": "WttHC",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"地精是魯莽與毀滅的化身。它們沉迷於搞破壞——動靜越大、越鬧騰、場面越混亂，就越合它們的意。地精發動突襲，往往既是為了享受縱火和折磨牲畜的快感，也是更大規模破壞計劃的一環。",
						"地精武者擅長製造惡作劇，但有些會投身於更高尚的事業。"
					]
				}
			],
			"images": [
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "bestiary/WttHC/Goblin Warrior (Stranger Things).webp"
					},
					"width": 999,
					"height": 1000
				}
			],
			"ENG_name": "Goblin Warrior"
		},
		{
			"name": "警衛",
			"source": "WttHC",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"警衛們保護人民、設施和物品，無論是為了薪水還是出於責任感。他們可能警惕地或心不在焉地履行職責。有些人在危險的預兆出現時就發出警報，並用生命捍衛他們職責。如果他們的薪水與他們面臨的風險不匹配，其他人則會直接走開。警衛們很敏銳，但大多數人幾乎沒有受過軍事訓練。他們可能是保鏢、崗哨、城市衛隊的成員，或其他敏銳的戰士。"
					]
				}
			],
