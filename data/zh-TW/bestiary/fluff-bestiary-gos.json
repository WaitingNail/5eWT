						"path": "bestiary/GoS/Monstrous Peryton.webp"
					},
					"credit": "Eric Belisle",
					"width": 1000,
					"height": 686
				}
			],
			"ENG_name": "Monstrous Peryton"
		},
		{
			"name": "多利先生",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"統治斯泰爾斯的四位議員之一，多里先生將他被詛咒的本質公然隱藏起來。他罕見的、對液體敏感的\"皮膚狀況\"實際上是與創造斯庫姆的阿波洛斯（aboleth）疾病相同的一種形式，儘管多里的病情並不嚴重，他已經設法保留了自己的自由意志。"
									]
								}
							]
						}
					]
				}
			],
			"images": [
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "bestiary/GoS/Mr. Dory.webp"
					},
					"credit": "Joachim Barrum",
					"width": 593,
					"height": 800
				}
			],
			"ENG_name": "Mr. Dory"
		},
		{
			"name": "俄申努斯",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"在被捕獲之前，這位海精靈被指派調查《鹽沼澤的邪惡秘密》中海鬼的行動。Oceanus是一個聰明且足智多謀的精靈，他非常願意加入那些擁有勇敢之心和良好意圖的冒險者。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Oceanus"
		},
		{
			"name": "海盜水手長",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"大副（或船員長）負責組織船上的貨物和船員。大副是有能力的戰士，他們搬運貨物和施以打擊的經驗使他們成為難以對付的對手。在《鹽沼的邪惡秘密》中，Foul Frithoff是保護走私船上貨物的大副。自從一次嚴重的事故之後，他一直用一個鉤子代替一隻手臂的末端。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Pirate Bosun"
		},
		{
			"name": "海盜船長",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"海盜船長們在海上度過一生，透過血腥和大膽的方式贏得並保持指揮權。船長們令人印象深刻的劍術和尖銳的話語在船員中既激發了信心也引發了恐懼。Sigurd 'Snake Eyes' 是《Saltmarsh的邪惡秘密》中領導一群走私者的海盜船長。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Pirate Captain"
		},
		{
			"name": "海盜甲板法師",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"這些鹽漬的魔法實踐者既博學又迷信。海盜船的船員通常會讓甲板法師有較大的活動空間，因為他們會使用魔法在船上各處移動，並釋放他們的鹹水魔法對抗攻擊者。《鹽沼的險惡秘密》中的海鬼號船是名為Punketah的海盜甲板法師的家。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Pirate Deck Wizard"
		},
		{
			"name": "海盜大副",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"這些務實的水手是海盜船船長的可靠盟友。退役士兵和訓練有素的僱傭兵經常在海盜船上找到工作作為大副。在《鹽沼澤的邪惡秘密》中，血腥的比約恩擔任\"海鬼\"號上的第一大副。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Pirate First Mate"
		},
		{
			"name": "裂潮祭司",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"裂潮教派的祭司們秘密地聚集在陰謀集團中，進行黑暗儀式，以榮耀奧赫德拉，邪惡水元素的公主，作為水的破壞力的化身。他們相信，使用水來殺死敵人，例如透過儀式性的溺水，可以獲得奧赫德拉的青睞。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Rip Tide Priest"
		},
		{
			"name": "鯊華大劍師",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"作為無數戰役中狡猾的老手，鯊華魚人劍術大師用被擊敗敵人的骨頭裝飾盔甲。如《最終之敵》所述，鯊華魚人劍術大師通常作為軍官服役於鯊華魚人軍隊中。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Sahuagin Blademaster"
		},
		{
			"name": "鯊華勇士",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"那些透過英勇行為證明自己的鯊華魚人戰士被授予頭銜和地位。鯊華魚人冠軍經常在鯊華魚人軍隊中擔任副官，就像在《The Final Enemy》中一樣。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Sahuagin Champion"
		},
		{
			"name": "鯊華珊瑚粉碎者",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"在《The Final Enemy》中作為前線的重擊手，珊瑚粉碎者是從最強壯的鯊華魚人戰士中挑選出來的。他們的身體力量克服了水的阻力，他們以同樣的熱情揮舞著錘子攻擊建築和敵人。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Sahuagin Coral Smasher"
		},
		{
			"name": "鯊華深潛者",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"這些強大的鯊華魚人人，在《最終敵人》中被發現，透過塞科拉的神聖魔法被改造，使他們能更好地探索海洋最黑暗的深處。在水外，他們緊貼陰影，充當獵人和刺客。一個可以照亮的長鱗片誘餌從深潛者的額頭延伸出來。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Sahuagin Deep Diver"
		},
		{
			"name": "鯊華魚人幼體叢集",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"在《最終敵人》中翻騰的海水中，這些鯊華魚人幼崽的群體對它們遇到的任何生物都是危險的。其他的鯊華魚人會避開這些群體，而個體成員則相互吞噬，直到只剩下最強壯的幼崽存活下來，成長為成熟的鯊華魚人。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Sahuagin Hatchling Swarm"
		},
		{
			"name": "鯊華高階女祭司",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"鯊華魚人的高階女祭司是所有塞科拉信徒中最虔誠和最兇猛的。她手持一根鑲嵌著鋒利鯊魚牙齒的法杖，可以在《The Final Enemy》中看到她領導黑暗儀式。"
									]
								}
							]
						}
					]
				}
			],
