	"monsterFluff": [
		{
			"name": "雙頭蛇",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"在丹沃特的危險之地發現的這些奇特爬行動物，它們的蛇形身體兩端各有一個頭部，每個頭部都裝備有毒牙。安菲斯巴恩透過一個頭部抓住另一個頭部的頸部來移動，形成一個在地面上滾動的環。"
									]
								}
							]
						}
					]
				}
			],
			"images": [
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "bestiary/MOT/Amphisbaena.webp"
					},
					"credit": "Alex Horley-Orlandelli",
					"width": 1000,
					"height": 840
				}
			],
			"ENG_name": "Amphisbaena"
		},
		{
			"name": "啵靈蛙鳴唱者",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"一些啵靈蛙天生具有將魔法編織進他們的歌聲中的能力。這些罕見的個體在受保護的飛地中長大，他們被教導使用自己的魔法來治療和傷害。正如在《Dunwater的危險》中展示的那樣，他們是最自負的啵靈蛙之一。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Bullywug Croaker"
		},
		{
			"name": "啵靈蛙王族",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"最大且最聰明的沼澤怪通常會成為其族群的領袖。這些嘲笑的樣本穿著由皮革、粗布和沼澤植物碎片製成的長袍。正如在《鄧沃特的危險》中所見，一個沼澤怪王常常伴隨著並騎在一隻巨大的啵靈蛙上。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Bullywug Royal"
		},
		{
			"name": "船長贊德羅斯",
			"source": "GoS",
			"images": [
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "bestiary/GoS/004-01-04.webp"
					},
					"credit": "Leesha Hannigan",
					"width": 665,
					"height": 1000
				}
			],
			"ENG_name": "Captain Xendros"
		},
		{
			"name": "溺亡者修行僧",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"身穿破爛長袍，拳頭上纏繞著長長的腐爛布條，溺亡的苦行僧以驚人的速度移動，對於不死生物來說這是不同尋常的。這位武術家在塔默勞特的命運中從海洋中升起，儘管肉體腐爛，仍然保持著戰鬥反應。"
									]
								},
								{
									"type": "entries",
									"name": "藍腐病",
									"entries": [
										"這種疾病針對類人生物。感染了藍疫的受害者會在面部和背部長出醜陋的藍色皰疹。這種病透過不死生物（包括塔瑪羅特命運中的溺水者）傳播，受害者通常是透過被感染生物造成的傷口獲得的。疾病引起的皰疹在{@dice 1d4}小時內顯現，導致受害者的體質和魅力值各減少{@dice 1d4}，最低降至3。緊隨其後的是發燒和四肢的刺痛感。感染的生物對光耀傷害易感，並獲得了在水下呼吸的能力。",
										"在每次長休結束時，受感染的生物進行一次 {@dc 12} 體質豁免。若成功，受害者恢復因疾病失去的1點體質和1點魅力。如果受感染的生物恢復了所有因疾病失去的屬性點，它即被治癒。其他提升受害者屬性值的效果無法治癒該疾病。若豁免失敗，受害者受到18（{@damage 4d8}）點暗蝕傷害，彷彿癤子爆裂並擴散。因該傷害生命值降至0的生物在疾病治癒前無法恢復生命值，儘管它可以如常被穩定。"
									],
									"ENG_name": "Bluerot"
								}
							]
						}
					]
				}
			],
			"images": [
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "bestiary/GoS/Drowned One.webp"
					},
					"credit": "Shawn Wood",
					"width": 366,
					"height": 1000
				}
			],
			"ENG_name": "Drowned Ascetic"
		},
		{
			"name": "溺亡者刺客",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"溺水的刺客在其前職業的陰森啞劇中潛行和殺戮。它從陰影中悄悄移動，出現在塔默勞特命運的不死生物攻擊中，用其長滿藤壺的手弩瞄準致命的精確度。隱藏在一塊簡單的浮木面具後面，這個生物的面孔一旦暴露，就會在凡人心中引起恐怖。"
									]
								},
								{
									"type": "entries",
									"name": "藍腐病",
									"entries": [
										"這種疾病針對類人生物。感染了藍疫的受害者會在面部和背部長出醜陋的藍色皰疹。這種病透過不死生物（包括塔瑪羅特命運中的溺水者）傳播，受害者通常是透過被感染生物造成的傷口獲得的。疾病引起的皰疹在{@dice 1d4}小時內顯現，導致受害者的體質和魅力值各減少{@dice 1d4}，最低降至3。緊隨其後的是發燒和四肢的刺痛感。感染的生物對光耀傷害易感，並獲得了在水下呼吸的能力。",
										"在每次長休結束時，受感染的生物進行一次 {@dc 12} 體質豁免。若成功，受害者恢復因疾病失去的1點體質和1點魅力。如果受感染的生物恢復了所有因疾病失去的屬性點，它即被治癒。其他提升受害者屬性值的效果無法治癒該疾病。若豁免失敗，受害者受到18（{@damage 4d8}）點暗蝕傷害，彷彿癤子爆裂並擴散。因該傷害生命值降至0的生物在疾病治癒前無法恢復生命值，儘管它可以如常被穩定。"
									],
									"ENG_name": "Bluerot"
								}
							]
						}
					]
				}
			],
