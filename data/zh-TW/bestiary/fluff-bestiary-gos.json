			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"這些兇猛的庫阿林斯為他們的人民執行特殊任務，例如在《丹沃特的危險》中遇到的外交使者。庫阿林斯中士專注於戰場上最重要的威脅，然後逐一消除這些威脅。"
									]
								}
							]
						}
					]
				}
			],
