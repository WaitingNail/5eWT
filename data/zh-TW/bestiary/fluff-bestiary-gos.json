		{
			"name": "克雷爾·格羅格",
			"source": "GoS",
			"images": [
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "bestiary/GoS/034-04-04-unholy-shrine-p92.webp"
					},
					"credit": "Sam Keiser",
					"width": 1000,
					"height": 618
