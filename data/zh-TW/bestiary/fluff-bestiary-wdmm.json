					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"無法忍受常態和一致性，阿爾庫提亞沉迷於改變自己、她的環境和其他生物。她的情緒也總是變化無常。"
							]
						}
					]
				}
			],
