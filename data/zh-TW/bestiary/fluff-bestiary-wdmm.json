		{
			"name": "焰火羅莎",
			"source": "WDMM",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"火巨人擁有深色皮膚和火焰般的紅髮，作為士兵和征服者，他們有著令人畏懼的名聲。他們居住在火山、熔岩流和岩石山脈中，以其燃燒、掠奪和破壞的能力而聞名。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Emberosa"
		},
		{
			"name": "埃扎特",
			"source": "WDMM",
			"images": [
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "bestiary/WDMM/Ezzat.webp"
					},
