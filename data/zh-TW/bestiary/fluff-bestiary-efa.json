		{
			"name": "波洛馬走私犯",
			"source": "EFA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"波洛馬氏族僱傭的走私者（大多是半身人）以難以捕獲而聞名。這些飆速跑者罪犯在薩恩各地販運從麻醉劑到非法奧術武器的所有物品。"
					]
				}
			],
			"images": [
				{
					"type": "image",
					"href": {
