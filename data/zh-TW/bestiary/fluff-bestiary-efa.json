					"height": 1000
				}
			],
			"ENG_name": "Dreaming Dark Mindkiller"
		},
		{
			"name": "祖母綠爪指揮官",
			"source": "EFA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"祖母綠爪指揮官領導大型團隊計程車兵，鼓舞類人生物和亡靈狂熱的奉獻。"
					]
				}
			],
