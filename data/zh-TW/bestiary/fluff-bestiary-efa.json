			"ENG_name": "Sivis Scribe"
		},
		{
			"name": "塔卡南掠奪者",
			"source": "EFA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"這名強大的刺客依賴傳送來捕獲目標無知覺並造成快速死亡。"
					]
				}
			],
			"images": [
				{
