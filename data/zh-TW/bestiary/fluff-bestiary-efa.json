						"path": "bestiary/EFA/Boromar Smuggler.webp"
					},
					"width": 411,
					"height": 1000
				}
			],
			"ENG_name": "Boromar Smuggler"
		},
		{
			"name": "波洛馬副頭目",
			"source": "EFA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"二老闆監督更大的氏族運作，例如賭場和等待傳送的走私商品倉庫。這些習慣於犯罪生活方式的堅韌個體（主要是半身人）以精心計算的輕鬆方式忽視並處理威脅。"
					]
				}
			],
			"images": [
