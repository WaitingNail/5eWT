			],
			"ENG_name": "Cannith Artificer"
		},
		{
			"name": "達斯克打手",
			"source": "EFA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"令人生畏且強大，當需要更暴力和果斷的武力展示時，打手們領導達斯克業務。這些執法者陶醉於他們工作的殘暴。"
					]
				}
			],
