		},
		{
			"name": "獵人戰隼",
			"source": "DIP",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"如果冒險者們訪問他在無冬森林的狩獵小屋，他們就會遇到獵人Falcon。"
							]
						}
					]
				}
			],
