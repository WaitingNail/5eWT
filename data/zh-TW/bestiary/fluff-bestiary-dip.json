		{
			"name": "東容·拉斯坎",
			"source": "DIP",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								"接受山腳任務的冒險者們遇到了唐-喬恩·拉斯金，一個無畏的麻煩解決者，他經歷了比他應得的更多的冒險。"
							]
						}
					]
				}
			],
