		},
		{
			"name": "碎腦者",
			"source": "PaBTSO",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"碎腦者者看起來像巨大的大腦，有著粗壯的腿，它們穿著由Ilvaash的符文（觸手、大腦和讓人想起顎部的鋸齒狀線條的結）相互連線的鋼製盔甲。"
					]
				}
			],
			"ENG_name": "Brain Breaker"
		},
