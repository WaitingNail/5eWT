			"source": "HotB",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"館長透過為聖祠和神廟服務獲得與神明的特殊聯絡。這種奉獻賦予這些精神領袖醫療傷患、驅退邪惡和復活亡者的法力。"
					]
				}
			],
