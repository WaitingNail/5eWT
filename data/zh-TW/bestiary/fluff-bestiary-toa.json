		{
			"name": "娜",
			"source": "ToA",
			"entries": [
				"年輕的王子納是一個AC 10、HP 3的非戰鬥人員。他的大部分時光都在鳥羽人這裡度過，因此他將自己也認為是他們中的一員。他的穿著如同鳥羽人一般，而且更傾向於說氣族語而非通用語。",
				{
					"type": "list",
					"name": "納的特質",
					"style": "list-hang-notitle",
					"items": [
						{
							"name": "理念",
							"type": "item",
							"entries": [
								"\"我想成為一名鳥羽人，我想學習如何像鳥兒那樣飛翔！\""
							],
							"ENG_name": "Ideal"
						},
						{
							"name": "牽掛",
							"type": "item",
							"entries": [
								"\"我深愛我的姊姊，我深愛鳥羽人們。她們就是我的全部。\""
							],
							"ENG_name": "Bond"
						},
						{
							"name": "缺陷",
							"type": "item",
							"entries": [
								"\"我對這個世界一無所知。\""
							],
							"ENG_name": "Flaw"
						}
					],
					"ENG_name": "Na's Traits"
				}
			],
			"ENG_name": "Na"
		},
