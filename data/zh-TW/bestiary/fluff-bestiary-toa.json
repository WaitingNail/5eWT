						"path": "bestiary/ToA/Chwinga.webp"
					},
					"width": 1100,
					"height": 725
				}
			],
			"ENG_name": "Chwinga"
		},
		{
			"name": "粘土角鬥士",
			"source": "ToA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"粘土角鬥士在被攻擊或被召喚到角鬥場時會戰鬥。如果在角鬥場外降至0生命值，角鬥士會連同其所有物一起消失，然後在其牢房中以滿生命值的狀態重新出現，手持長矛和盾牌，並儘可能返回角鬥場。如果在角鬥場內被擊敗，角鬥士會在重新出現在其牢房前留下其長矛。"
									]
								}
							]
						}
					]
				}
			],
			"ENG_name": "Clay Gladiator"
		},
		{
			"name": "龍餌",
			"source": "ToA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"龍餌是一名善良鬥士，也是一名類蜴人——一個起源於遙遠世界並且長壽的種族。很少有類蜴人在被遺忘的國度中居住，並且人們相信類蜴人族群並不存在於這個世界的任何一個角落。",
										"類蜴人的語言混合著咔嚓聲與口哨聲，並高出人類的聽覺範圍，所以龍餌傾向於依靠氣味來傳達自己的情感。為了被大部分用語言溝通的生物所理解，他必須\"撥出\"一種氣味。龍餌已知的氣味包括：硫磺味（困惑）、玫瑰香（悲傷）、檸檬香（歡愉或滿意）、烤麵包味（憤怒）、紫羅蘭香（危險或恐懼）、金銀花香（溫柔或關心）、焚香味（奉獻或虔誠）、焦油香（勝利或慶祝）、火腿香（緊張或擔心）。",
										"龍餌身高4尺10寸，重150磅，皮膚乾燥而褶皺。他手持一把神聖復仇者holy avenger長劍，並裝備著一面繪有藍紅白三色塗漆的盾牌。儘管他與聖武士有著相同的特性，但龍餌並非他們中的一員。他使用一種名為聖感的能力，能探測出60尺內任何生物的陣營。",
										{
											"name": "意外之友",
											"type": "entries",
											"entries": [
												"龍餌在南扎路港遇到了阿圖斯·辛貝爾，兩人很快知交莫逆。當阿圖斯訴說出他不斷尋找、只為與妻子艾麗珊達重逢之事時，龍餌用安靜的儀態與不同尋常的交流方法安撫了他。龍餌只是微笑著點了點頭，就同意幫助阿圖斯。作為楚爾特的常客，這名類蜴人十分了解叢林中的危險。"
											],
											"ENG_name": "An Unexpected Friendship"
										},
										{
											"name": "使用龍餌",
											"type": "entries",
											"entries": [
												"龍餌從未去過奧姆城，他並不知道這座城市在哪裡。如果玩家們扮演的角色說服了阿圖斯·辛貝爾幫助他們摧毀易魂裝置，則龍餌也會一同協助。"
											],
											"ENG_name": "Using Dragonbait"
										}
									]
								}
							]
						}
					]
				},
				{
					"type": "list",
					"name": "龍餌的特質",
					"style": "list-hang-notitle",
					"items": [
						{
							"name": "理念",
							"type": "item",
							"entries": [
								"龍餌思考著探索世界，見證更多世界奇蹟、並在路上幫助他人等事宜，他散發出檸檬香味。（翻譯：他有一顆探險者般的心。）"
							],
							"ENG_name": "Ideal"
						},
						{
							"name": "牽掛",
							"type": "item",
							"entries": [
								"龍餌幫助一位朋友進行他的探索之旅，他散發出焚香的味道。（翻譯：他會為了朋友赴湯蹈火。）"
							],
							"ENG_name": "Bond"
						},
						{
							"name": "缺陷",
							"type": "item",
							"entries": [
								"龍餌前往其他人害怕步入之所在，他\"撥出\"一股火腿般的味道。（翻譯：他從不擔心風險，只會一往無前。）"
							],
							"ENG_name": "Flaw"
						}
					],
					"ENG_name": "Dragonbait's Traits"
				}
			],
			"images": [
				{
					"type": "image",
