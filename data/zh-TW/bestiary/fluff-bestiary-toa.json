	"monsterFluff": [
		{
			"name": "阿瑟瑞克",
			"source": "ToA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"阿瑟瑞克是一位穿行於各個世界、以吞噬冒險者的靈魂為樂的大巫妖，他將這些冒險者引誘到遍佈陷阱的地下城中，使他們遭受可怕的死亡。失落的奧姆城地下就是一座這樣的地下城。這座地下城被稱為九神之墓，因為阿瑟瑞克殺死了九名偽神，並將k們封印於其中。最近，他製造了一個叫做易魂裝置的不死生物裝置，把它藏在了九神之墓的中心。"
									]
								}
							]
						}
					]
				},
				{
					"type": "list",
					"name": "阿瑟瑞克的特質",
					"style": "list-hang-notitle",
					"items": [
						{
							"name": "理念",
							"type": "item",
							"entries": [
								"\"當我可以成為神的創造者時，為什麼要成為神？\""
							],
							"ENG_name": "Ideal"
						},
						{
							"name": "牽掛",
							"type": "item",
							"entries": [
								"\"我建造地下城以誘捕並殺死強大的冒險者。他們的死亡與靈魂將成為我的養料。\""
							],
							"ENG_name": "Bond"
						},
						{
							"name": "缺陷",
							"type": "item",
							"entries": [
								"\"我往往會低估敵人的決心。\""
							],
							"ENG_name": "Flaw"
						}
					],
					"ENG_name": "Acererak's Traits"
				}
			],
