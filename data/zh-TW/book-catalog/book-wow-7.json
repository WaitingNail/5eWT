							"isSkipRootName": true
						}
					},
					"ENG_name": "Green Dragonflight"
				},
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "book/WoW/137-07-013.green-dragonflights.webp"
					},
					"width": 1700,
					"height": 985,
					"credit": "Jaemin Kim"
				},
				{
					"type": "entries",
					"name": "綠龍軍團雛龍",
					"id": "4e1",
					"entries": [
						"綠龍軍團儘可能在翡翠夢境中養育雛龍。在那裡，雛龍透過觀察生與死的輪迴，學會欣賞並傳揚自然永珍之美。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "綠龍軍團雛龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Green Dragonflight Whelp"
						}
					],
					"ENG_name": "Green Dragonflight Whelp"
				},
				{
					"type": "entries",
					"name": "綠龍軍團幼龍",
					"id": "4e2",
					"entries": [
						"自翡翠夢境而出的綠龍軍團幼龍已睿智到能在艾澤拉斯採取行動。它們常與年長的巨龍、暗夜精靈德魯伊和知識古樹結盟，以自然魔法掃除邪惡教團與入侵惡魔。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "綠龍軍團幼龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Green Dragonflight Drake"
						}
					],
					"ENG_name": "Green Dragonflight Drake"
				},
				{
					"type": "entries",
					"name": "綠龍軍團巨龍",
					"id": "4e3",
					"entries": [
						"綠龍軍團中最強大者與上古之神的爪牙作戰，並化為凡人化身與類人生物結盟。這場對抗上古之神的戰爭使綠龍時刻面臨被翡翠夢魘腐化的危險——那夢魘正是上古之神最偉大的勇士之一所造。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "綠龍軍團巨龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Green Dragonflight Dragon"
						}
					],
					"ENG_name": "Green Dragonflight Dragon"
				}
			],
			"ENG_name": "Green Dragonflight"
		},
