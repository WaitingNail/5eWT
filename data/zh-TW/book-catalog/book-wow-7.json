		{
			"type": "section",
			"name": "黑龍軍團",
			"id": "4ca",
			"entries": [
				{
					"type": "statblock",
					"prop": "monsterFluff",
					"name": "黑龍軍團",
					"source": "WoW",
					"data": {
						"renderCompact": {
							"isSkipRootName": true
						}
					},
					"ENG_name": "Black Dragonflight"
				},
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "book/WoW/130-07-006.black-dragonflights.webp"
					},
					"width": 1700,
					"height": 1030,
					"credit": "Caio Monteiro"
				},
				{
					"type": "entries",
					"name": "黑龍軍團雛龍",
					"id": "4cb",
					"entries": [
						"黑龍軍團雛龍是棲居在火山、溫泉與間歇泉附近的兇殘小生物。它們以巖漿吐息悶斃獵物，再從滾燙的熔岩團中剔食血肉。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "黑龍軍團雛龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Black Dragonflight Whelp"
						}
					],
					"ENG_name": "Black Dragonflight Whelp"
				},
				{
					"type": "entries",
					"name": "黑龍軍團幼龍",
					"id": "4cc",
					"entries": [
						"黑龍軍團幼龍運用魔法加熱土石所造之物。它們能瞬間把石頭熔成巖漿，並在其冷卻前重新塑形。這些幼龍樂於潛行跟蹤、迷惑獵物。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "黑龍軍團幼龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Black Dragonflight Drake"
						}
					],
					"ENG_name": "Black Dragonflight Drake"
				},
				{
					"type": "entries",
					"name": "黑龍軍團巨龍",
					"id": "4cd",
					"entries": [
						"完全成熟的黑龍軍團巨龍從空中威嚇艾澤拉斯各地，並化為人形偽裝操縱社會。披著凡人化身的黑龍通常有一頭烏黑的頭髮和一雙猩紅的眼睛。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "黑龍軍團巨龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Black Dragonflight Dragon"
						}
					],
					"ENG_name": "Black Dragonflight Dragon"
				}
			],
			"ENG_name": "Black Dragonflight"
		},
		{
			"type": "section",
			"name": "藍龍軍團",
			"id": "4cf",
			"entries": [
				{
					"type": "statblock",
					"prop": "monsterFluff",
					"name": "藍龍軍團",
					"source": "WoW",
					"data": {
						"renderCompact": {
							"isSkipRootName": true
						}
					},
					"ENG_name": "Blue Dragonflight"
				},
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "book/WoW/131-07-007.blue-dragonflights.webp"
					},
					"width": 1700,
					"height": 1104,
					"credit": "Ignatius Budi"
				},
				{
					"type": "entries",
					"name": "藍龍軍團雛龍",
					"id": "4d0",
					"entries": [
						"藍龍軍團雛龍表現出的智慧遠超其年齡。遇見冰釣者時，藍龍雛龍可能不會發動攻擊，而是提議交流知識，並約定分享捕到的魚。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "藍龍軍團雛龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Blue Dragonflight Whelp"
						}
					],
					"ENG_name": "Blue Dragonflight Whelp"
				},
				{
					"type": "entries",
					"name": "藍龍軍團幼龍",
					"id": "4d1",
					"entries": [
						"藍龍軍團的成員是奧術的虔心學子。藍龍軍團幼龍學習創造和驅散魔法效應，保護自己的秘密不被好事的魔法師窺探。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "藍龍軍團幼龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Blue Dragonflight Drake"
						}
					],
					"ENG_name": "Blue Dragonflight Drake"
				},
				{
					"type": "entries",
					"name": "藍龍軍團巨龍",
					"id": "4d2",
					"entries": [
						"藍龍軍團巨龍視自己為奧術的管家，蔑視濫用其恩賜的凡人。高貴的藍龍會充當凡人魔法師的睿智導師——例如卡雷苟斯曾長期以凡人化身與{@area 肯瑞託|30e|x}共事。而殘忍善妒的藍龍（如希亞尼戈薩）則試圖支配並懲罰濫用魔法的凡人。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "藍龍軍團巨龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Blue Dragonflight Dragon"
						}
					],
					"ENG_name": "Blue Dragonflight Dragon"
				}
			],
			"ENG_name": "Blue Dragonflight"
		},
		{
			"type": "section",
			"name": "青銅龍軍團",
			"id": "4d3",
			"entries": [
				{
					"type": "statblock",
					"prop": "monsterFluff",
					"name": "青銅龍軍團",
					"source": "WoW",
					"data": {
						"renderCompact": {
							"isSkipRootName": true
						}
					},
					"ENG_name": "Bronze Dragonflight"
				},
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "book/WoW/132-07-008.bronze-dragonflights.webp"
					},
					"width": 1700,
					"height": 1050,
					"credit": "Caio Monteiro"
				},
				{
					"type": "entries",
					"name": "青銅龍軍團雛龍",
					"id": "4d4",
					"entries": [
						"青銅龍軍團雛龍極有耐心。它們能在大漠中央一動不動站上數小時，等獵物經過時再以巨口或利爪出擊。許多旅人會把雛龍誤認成雕像。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "青銅龍軍團雛龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Bronze Dragonflight Whelp"
						}
					],
					"ENG_name": "Bronze Dragonflight Whelp"
				},
				{
					"type": "entries",
					"name": "青銅龍軍團幼龍",
					"id": "4d5",
					"entries": [
						"不少反派企圖馴服青銅龍軍團幼龍為己所用，想趁其年幼榨取其預知魔法。這些投機者很快就會領教自己的錯誤——青銅幼龍會用灼熱的沙焰吐息撕碎並灼爛他們的皮膚。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "青銅龍軍團幼龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Bronze Dragonflight Drake"
						}
					],
					"ENG_name": "Bronze Dragonflight Drake"
				},
				{
					"type": "entries",
					"name": "青銅龍軍團巨龍",
					"id": "4d6",
					"entries": [
						"成熟的青銅龍以維護艾澤拉斯唯一的真實時間線為己任。它們貼近類人文明生活，警惕來自其他時間線的旅人，或企圖篡改時光之路的人。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "青銅龍軍團巨龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Bronze Dragonflight Dragon"
						}
					],
					"ENG_name": "Bronze Dragonflight Dragon"
				}
			],
			"ENG_name": "Bronze Dragonflight"
		},
		{
			"type": "section",
			"name": "末日守衛",
			"id": "4d7",
			"entries": [
				{
					"type": "statblock",
