				},
				{
					"type": "entries",
					"name": "紅龍軍團雛龍",
					"id": "505",
					"entries": [
						"紅龍軍團雛龍雖小，熾烈的吐息卻威力驚人。這些生物的正義感驅使它們以善之名挑戰更強大的敵人。紅龍軍團雛龍幾乎從不臨陣脫逃，因為它們的驕傲尚未被歲月的智慧打磨。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "紅龍軍團雛龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Red Dragonflight Whelp"
						}
					],
					"ENG_name": "Red Dragonflight Whelp"
				},
				{
					"type": "entries",
					"name": "紅龍軍團幼龍",
					"id": "506",
					"entries": [
						"紅龍軍團幼龍治癒艾澤拉斯各地受汙染的土地。這些幼龍向地形噴吐灼熱的烈焰洪流，焚盡枯萎的植物，讓新生從灰燼中成長。在最緊要的關頭，它們會允許凡人英雄騎在背上作戰。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "紅龍軍團幼龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Red Dragonflight Drake"
						}
					],
					"ENG_name": "Red Dragonflight Drake"
				},
				{
					"type": "entries",
					"name": "紅龍軍團巨龍",
					"id": "507",
					"entries": [
						"紅龍軍團被視為艾澤拉斯最高貴的巨龍，立誓守護一切生命。但絕不要把他們的仁善誤解為軟弱；他們能造成可怕的毀滅，只是那份毀滅仍不敵其烈焰吐息中充盈的賦生之力。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "紅龍軍團巨龍",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Red Dragonflight Dragon"
						}
					],
					"ENG_name": "Red Dragonflight Dragon"
				}
			],
			"ENG_name": "Red Dragonflight"
		},
