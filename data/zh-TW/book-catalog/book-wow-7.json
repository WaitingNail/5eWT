						}
					},
					"ENG_name": "Murlocs"
				},
				{
					"type": "entries",
					"name": "魚人搜掠者",
					"id": "4ed",
					"entries": [
						"魚人搜掠者生活在水體的邊緣地帶，大部分時間在泥沼與淺水中覓食。在所有魚人中，搜掠者最常單獨行動，它們往往充當聚落的預警系統，把圖謀不軌者引到水邊，讓同伴伏擊。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "魚人搜掠者",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Murloc Forager"
						}
					],
					"ENG_name": "Murloc Forager"
				},
				{
					"type": "entries",
					"name": "魚人神諭者",
					"id": "4ee",
					"entries": [
						"神諭者率領其他魚人，用魔法守衛並治療同伴。魚人神諭者比其他魚人更願意嘗試與不會說納格利什語者交流。",
						{
							"type": "statblock",
							"tag": "creature",
							"name": "魚人神諭者",
							"source": "WoW",
							"style": "narrow",
							"ENG_name": "Murloc Oracle"
						},
						{
							"type": "inset",
							"name": "熊怪、魚人與野豬人",
							"id": "4ef",
							"entries": [
								"除本章呈現的資料卡外，《{@book 怪物圖鑑|XMM}》中的任何類人生物資料卡都可以用作熊怪、魚人或野豬人。若用作魚人，為其增加等於速度加 10 尺的游泳速度，以及本節資料卡中的兩棲特性。",
								"《{@i 魔獸世界}》中的類人生物常以職能命名，這些名字也能提示應為其選用何種資料卡。下表列出一些常見的類人生物職能及建議使用的資料卡。",
								{
									"type": "table",
									"colLabels": [
										"職能",
										"資料卡"
									],
									"colStyles": [
										"col-4",
										"col-8"
									],
									"rows": [
										[
											"伏擊者",
											"{@creature Bandit|XMM|匪徒}（CR 1/8）、{@creature Bandit Captain|XMM|匪幫隊長}（CR 2）"
										],
										[
											"復仇者",
											"{@creature Berserker|XMM|狂戰士}（CR 2）、{@creature Berserker Commander|XMM|狂戰將}（CR 8）"
										],
										[
											"海岸奔襲者",
											"{@creature Tough|XMM|打手}（CR 1/2）"
										],
										[
											"守衛者或巢穴守望者",
											"{@creature Guard|XMM|警衛}（CR 1/8）、{@creature Guard Captain|XMM|警衛隊長}（CR 4）"
										],
										[
											"獵人",
											"{@creature Scout Captain|XMM|斥候隊長}（CR 3）"
										],
										[
											"潛伏者",
											"{@creature Spy|XMM|間諜}（CR 1）"
										],
										[
											"秘術師",
											"{@creature Druid|XMM|德魯伊}（CR 2）"
										],
										[
											"探路者",
											"{@creature Scout Captain|XMM|斥候隊長}（CR 3）"
										],
										[
											"掠襲者",
											"{@creature Berserker|XMM|狂戰士}（CR 2）"
										],
										[
											"斥候",
											"{@creature Scout|XMM|斥侯}（CR 1/2）"
										],
										[
											"薩滿",
											"{@creature Druid|XMM|德魯伊}（CR 2）、{@creature Elemental Cultist|XMM|元素邪教徒}（CR 8）"
										],
										[
											"追跡者",
											"{@creature Scout|XMM|斥侯}（CR 1/2）"
										],
										[
											"武者",
											"{@creature Warrior Infantry|XMM|新晉武者}（CR 1/8）、{@creature Warrior Veteran|XMM|歷戰武者}（CR 3）"
										]
									]
								}
							],
							"ENG_name": "Furbolgs, Murlocs, and Quilboar"
						}
					],
					"ENG_name": "Murloc Oracle"
